  if(bx < bz){ x = bestRX; } else { z = bestRZ; }
  x = Math.max(-330, Math.min(330, x));
  z = Math.max(-330, Math.min(330, z));
  p.pos.set(x, 0, z);
  p.yaw = Math.atan2(player.pos.x - x, player.pos.z - z);

  const g = buildCarBody(0x1a1a1a, 0x0a0a0a, { police: true });
