let camMode = 0;
let fovBase = 62;
const camLook = new THREE.Vector3();
const _camIdeal = new THREE.Vector3();

function updateVisuals(dt){
  playerCar.position.set(player.pos.x, 0, player.pos.z);
  playerCar.rotation.y = player.yaw;

  const rollTarget = THREE.MathUtils.clamp(-player.omega * Math.abs(player.vel.dot(_f)) * 0.030, -0.12, 0.12);
  const pitchTarget = THREE.MathUtils.clamp(-player.ax * 0.012, -0.06, 0.06);
  playerBody.rotation.z += (rollTarget - playerBody.rotation.z) * Math.min(1, dt*5.5);
  playerBody.rotation.x += (pitchTarget - playerBody.rotation.x) * Math.min(1, dt*5.5);

  pWheels.fl.pivot.rotation.y = player.steer;
  pWheels.fr.pivot.rotation.y = player.steer;
  pWheels.fl.spin.rotation.x = player.wheelSpin;
  pWheels.fr.spin.rotation.x = player.wheelSpin;
  pWheels.rl.spin.rotation.x = player.wheelSpin;
  pWheels.rr.spin.rotation.x = player.wheelSpin;

  const braking = (player.brakeIn > 0 || player.handbrakeIn > 0) ? 1 : 0;
  if(pBody.userData.tailMat){
    const target = 0.5 + braking * 2.4;
    pBody.userData.tailMat.emissiveIntensity += (target - pBody.userData.tailMat.emissiveIntensity) * Math.min(1, dt*14);
  }

  // damage smoke / fire from hood
  damageSmokeTimer += dt;
  const smokeRate = health < 30 ? 0.04 : health < 60 ? 0.1 : 1;
  if(health < 60 && damageSmokeTimer > smokeRate && !gameOver){
    damageSmokeTimer = 0;
    const hx = player.pos.x + Math.sin(player.yaw) * 1.9;
    const hz = player.pos.z + Math.cos(player.yaw) * 1.9;
    const isFire = health < 30;
    for(let i=0;i<2;i++){
      emitParticle(
        hx + (Math.random()-0.5)*0.5,
        0.95 + Math.random()*0.3,
        hz + (Math.random()-0.5)*0.5,
        (Math.random()-0.5)*1.6,
        1.8 + Math.random()*1.8,
        (Math.random()-0.5)*1.6,
        isFire ? 0.35 : 0.9 + Math.random()*0.6,
        isFire ? 1.6 : 0.45,
        isFire ? 0.55 : 0.42,
        isFire ? 0.15 : 0.4
      );
    }
  }

  // police visuals
  const flashPhase = Math.floor(performance.now() / 130) % 2;
  for(const p of policeCars){
    p.mesh.position.set(p.pos.x, 0, p.pos.z);
    p.mesh.rotation.y = p.yaw;
    p.wheels.fl.pivot.rotation.y = p.steer;
    p.wheels.fr.pivot.rotation.y = p.steer;
    p.wheels.fl.spin.rotation.x = p.wheelSpin;
    p.wheels.fr.spin.rotation.x = p.wheelSpin;
    p.wheels.rl.spin.rotation.x = p.wheelSpin;
    p.wheels.rr.spin.rotation.x = p.wheelSpin;
    if(p.lightBar){
      p.lightBar.red.emissiveIntensity = flashPhase ? 2.5 : 0.2;
      p.lightBar.blue.emissiveIntensity = flashPhase ? 0.2 : 2.5;
    }
  }

  for(const t of trafficCars){
    t.mesh.position.set(t.pos.x, 0, t.pos.z);
    t.mesh.rotation.y = t.yaw;
  }

  for(const p of pedestrians){
    if(p.alive){
      p.mesh.position.set(p.pos.x, 0, p.pos.z);
      p.mesh.rotation.y = p.yaw;
    } else {
      p.deadT += dt;
      if(p.deathVel){
        p.deathVel.y -= 22 * dt;
        p.pos.x += p.deathVel.x * dt;
        p.pos.z += p.deathVel.z * dt;
        p.mesh.position.set(p.pos.x, Math.max(0, p.mesh.position.y + p.deathVel.y * dt), p.pos.z);
        p.mesh.rotation.x += dt * 5;
        p.mesh.rotation.z += dt * 3;
      }
      if(p.deadT > 2){ p.mesh.visible = false; }
    }
  }

  sun.position.set(player.pos.x + 120, 180, player.pos.z + 80);
  sun.target.position.set(player.pos.x, 0, player.pos.z);
  sun.target.updateMatrixWorld();

  updateCamera(dt);

  damageFlash = Math.max(0, damageFlash - dt * 2.2);
  elFlash.style.background = `rgba(220,40,30,${damageFlash * 0.55})`;

  // decay shake
  shakeAmount = Math.max(0, shakeAmount - dt * 3.5);
}

function updateCamera(dt){
  const f = _v1.set(Math.sin(player.yaw), 0, Math.cos(player.yaw));
  const speed = Math.abs(player.vel.dot(f));

  if(camMode === 0){
    const back = 7.5 + speed * 0.06;
    const high = 3.0 + speed * 0.013;
    _camIdeal.set(0, high, -back).applyAxisAngle(UP, player.yaw).add(player.pos);
    _camIdeal.y = Math.max(_camIdeal.y, 0.9);
    const k = 1 - Math.exp(-7.0 * dt);
    camera.position.lerp(_camIdeal, k);
    camLook.copy(player.pos).add(_v2.set(0, 1.15, 0)).addScaledVector(f, 6 + speed * 0.15);
    camera.lookAt(camLook);
    fovBase = 62 + Math.min(12, speed * 0.45);
  } else if(camMode === 1){
    const p = _v1.copy(player.pos).add(_v2.set(0, 1.42, 0.45).applyAxisAngle(UP, player.yaw));
    camera.position.copy(p);
    camLook.copy(p).addScaledVector(f, 12).add(_v2.set(0, -0.35, 0));
    camera.lookAt(camLook);
    fovBase = 68 + Math.min(12, speed * 0.45);
  } else {
    _camIdeal.set(0, 10, -18).applyAxisAngle(UP, player.yaw).add(player.pos);
    camera.position.lerp(_camIdeal, 1 - Math.exp(-3.0 * dt));
    camLook.copy(player.pos).add(_v2.set(0, 1.2, 0));
    camera.lookAt(camLook);
    fovBase = 55;
  }

  // shake applied AFTER lookAt
  if(shakeAmount > 0.01){
    const s = shakeAmount;
    camera.position.x += (Math.random()-0.5) * s * 0.35;
    camera.position.y += (Math.random()-0.5) * s * 0.28;
    camera.position.z += (Math.random()-0.5) * s * 0.35;
    camera.rotation.z += (Math.random()-0.5) * s * 0.03;
  }

  camera.fov += (fovBase - camera.fov) * Math.min(1, dt * 4);
  camera.updateProjectionMatrix();
}

/* ============================================================
   AI UPDATES
   ============================================================ */
function updatePolice(dt){
  const desired = Math.min(POLICE_MAX, 2 + wantedLevel);
  while(policeCars.length < desired) spawnPolice();

  for(let i=policeCars.length-1; i>=0; i--){
    const p = policeCars[i];
    const d = p.pos.distanceTo(player.pos);
    if(d > 220 || (p.vel.length() < 0.2 && d > 130)){
      scene.remove(p.mesh);
      policeCars.splice(i,1);
    }
  }

  for(const p of policeCars){
    const inp = policeAI(p, dt);
    stepVehicle(p, inp, P_POLICE, dt);
    collideBuildings(p, 1.5);
  }

  for(let i=0;i<policeCars.length;i++){
    for(let j=i+1;j<policeCars.length;j++){
      const a = policeCars[i], b = policeCars[j];
      const dx = a.pos.x - b.pos.x;
      const dz = a.pos.z - b.pos.z;
      const d2 = dx*dx + dz*dz;
      const minD = 3.6;
      if(d2 < minD*minD && d2 > 0.01){
        const d = Math.sqrt(d2);
        const nx = dx/d, nz = dz/d;
        const overlap = (minD - d) * 0.5;
        a.pos.x += nx * overlap; a.pos.z += nz * overlap;
        b.pos.x -= nx * overlap; b.pos.z -= nz * overlap;
      }
    }
  }
}

function updateTraffic(dt){
  for(const t of trafficCars){
    const f = _v1.set(Math.sin(t.yaw), 0, Math.cos(t.yaw));
    t.vel.copy(f).multiplyScalar(t.speed);
    t.pos.addScaledVector(t.vel, dt);
    t.spin += t.speed / 0.36 * dt;

    if(t.isX){
      if(t.pos.z > 320) t.pos.z = -320;
      if(t.pos.z < -320) t.pos.z = 320;
    } else {
      if(t.pos.x > 320) t.pos.x = -320;
      if(t.pos.x < -320) t.pos.x = 320;
    }

    if(t.wheels){
      t.wheels.fl.spin.rotation.x = t.spin;
      t.wheels.fr.spin.rotation.x = t.spin;
      t.wheels.rl.spin.rotation.x = t.spin;
      t.wheels.rr.spin.rotation.x = t.spin;
    }
  }
}

function updatePedestrians(dt){
  for(const p of pedestrians){
    if(!p.alive) continue;
    const f = _v1.set(Math.sin(p.yaw), 0, Math.cos(p.yaw));
    p.pos.addScaledVector(f, p.speed * dt);
    if(p.isX){
      if(p.pos.z > 320) p.pos.z = -320;
      if(p.pos.z < -320) p.pos.z = 320;
    } else {
      if(p.pos.x > 320) p.pos.x = -320;
      if(p.pos.x < -320) p.pos.x = 320;
    }
    p.mesh.children[0].position.y = 0.9 + Math.sin(performance.now()*0.008 + p.pos.x) * 0.04;
  }
}

/* ============================================================
   PLAYER PHYSICS UPDATE
