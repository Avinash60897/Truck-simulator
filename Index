function spawnPolice(){
  const p = {
    pos: new THREE.Vector3(),
    vel: new THREE.Vector3(),
    yaw: 0, omega: 0, omegaDyn: 0, ax: 0,
    steer: 0, wheelSpin: 0,
    isPlayer: false,
