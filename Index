  const dist = 55 + Math.random()*55;
  let x = player.pos.x + Math.sin(ang) * dist;
  let z = player.pos.z + Math.cos(ang) * dist;
  let bestRX = ROADS[0], bestRZ = ROADS[0];
  let bx = 1e9, bz = 1e9;
  for(const r of ROADS){
    if(Math.abs(x - r) < bx){ bx = Math.abs(x - r); bestRX = r; }
