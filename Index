/* ============================================================
   POLICE AI
   ============================================================ */
const _aiFwd = new THREE.Vector3();
const _aiRight = new THREE.Vector3();
const _aiTo = new THREE.Vector3();
const _aiAhead = new THREE.Vector3();
const _aiLeft = new THREE.Vector3();
const _aiRightA = new THREE.Vector3();
const _aiPredicted = new THREE.Vector3();

function policeAI(p, dt){
  _aiTo.subVectors(player.pos, p.pos);
  const dist = _aiTo.length();
  _aiTo.normalize();

  _aiFwd.set(Math.sin(p.yaw), 0, Math.cos(p.yaw));
  _aiRight.set(-Math.cos(p.yaw), 0, Math.sin(p.yaw));

  const fdot = _aiTo.dot(_aiFwd);
  const rdot = _aiTo.dot(_aiRight);
  const angle = Math.atan2(rdot, fdot);
  let steer = -angle * 0.85;
  steer = Math.max(-1, Math.min(1, steer));

  if(fdot < -0.5 && Math.abs(rdot) < 0.25) steer = 1;

  if(dist < 25 && fdot > 0.4){
    const t = dist / Math.max(8, p.vel.length());
    _aiPredicted.copy(player.pos).addScaledVector(player.vel, t*0.5);
    _aiTo.subVectors(_aiPredicted, p.pos).normalize();
    const newAngle = Math.atan2(_aiTo.dot(_aiRight), _aiTo.dot(_aiFwd));
    steer = -newAngle * 1.1;
    steer = Math.max(-1, Math.min(1, steer));
  }

  let throttle = 1, brake = 0;
  if(dist < 6){ throttle = 0.5; brake = 0.2; }
  else if(dist < 12){ throttle = 0.85; }

  _aiAhead.copy(p.pos).addScaledVector(_aiFwd, 8);
  _aiLeft.copy(p.pos).addScaledVector(_aiFwd, 8).addScaledVector(_aiRight, -3);
  _aiRightA.copy(p.pos).addScaledVector(_aiFwd, 8).addScaledVector(_aiRight, 3);

  if(inBuilding(_aiAhead.x, _aiAhead.z, 1)){
    const leftClear = !inBuilding(_aiLeft.x, _aiLeft.z, 1);
    const rightClear = !inBuilding(_aiRightA.x, _aiRightA.z, 1);
    if(leftClear && !rightClear) steer = 1;
    else if(rightClear && !leftClear) steer = -1;
    else steer = rdot > 0 ? -1 : 1;
    throttle = Math.min(throttle, 0.4);
  }

  const speed = p.vel.length();
  if(speed < 0.8 && !p.reverseTimer){
    p.stuckTimer += dt;
    if(p.stuckTimer > 1.0){ p.reverseTimer = 1.1; p.stuckTimer = 0; }
  } else if(speed > 1.5){
    p.stuckTimer = 0;
  }

  if(p.reverseTimer > 0){
    p.reverseTimer -= dt;
    return { throttle: -0.7, brake: 0, handbrake: 0, steer: -steer };
  }

  return { throttle, brake, handbrake: 0, steer };
}

