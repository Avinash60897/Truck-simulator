let steerInput = 0;
const keys = Object.create(null);

addEventListener('keydown', e => {
  keys[e.code] = true;
  if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Space'].includes(e.code)) e.preventDefault();
  if(e.code === 'KeyR') restartGame();
  if(e.code === 'KeyC') camMode = (camMode + 1) % 3;
});
addEventListener('keyup', e => { keys[e.code] = false; });
addEventListener('blur', () => { for(const k in keys) keys[k] = false; });

function readPlayerInput(){
  const raw = ((keys['KeyA']||keys['ArrowLeft'])?1:0) - ((keys['KeyD']||keys['ArrowRight'])?1:0);
  steerInput += (raw - steerInput) * 0.15;
  return {
    throttle: (keys['KeyW']||keys['ArrowUp']) ? 1 : 0,
    brake: (keys['KeyS']||keys['ArrowDown']) ? 1 : 0,
    handbrake: keys['Space'] ? 1 : 0,
    steer: steerInput
  };
}

/* ============================================================
   COLLISION: PLAYER vs OTHERS
   ============================================================ */
function playerVsPolice(){
  for(const p of policeCars){
    const dx = player.pos.x - p.pos.x;
    const dz = player.pos.z - p.pos.z;
    const d2 = dx*dx + dz*dz;
    const minD = 2.6;
    if(d2 < minD*minD){
      const d = Math.sqrt(d2) || 0.001;
      const nx = dx/d, nz = dz/d;
      const overlap = minD - d;
      player.pos.x += nx * overlap * 0.75;
      player.pos.z += nz * overlap * 0.75;
      p.pos.x -= nx * overlap * 0.35;
      p.pos.z -= nz * overlap * 0.35;

      const rvx = player.vel.x - p.vel.x;
      const rvz = player.vel.z - p.vel.z;
      const vn = rvx*nx + rvz*nz;
      if(vn < 0){
        const impactSpeed = -vn;
        if(impactSpeed > 2.5){
          const dmg = (impactSpeed - 2.5) * 1.6;
          damagePlayer(dmg, (player.pos.x+p.pos.x)/2, 0.7, (player.pos.z+p.pos.z)/2);
          bumpWanted(0.3);
        }
        const imp = impactSpeed * 0.6;
        player.vel.x += nx * imp;
        player.vel.z += nz * imp;
        p.vel.x -= nx * imp * 0.7;
        p.vel.z -= nz * imp * 0.7;
        player.omega += (Math.random()-0.5) * 0.4;
        p.omega += (Math.random()-0.5) * 0.5;
      }
    }
  }
}

function playerVsTraffic(){
  for(const t of trafficCars){
    const dx = player.pos.x - t.pos.x;
    const dz = player.pos.z - t.pos.z;
    const d2 = dx*dx + dz*dz;
    const minD = 2.5;
    if(d2 < minD*minD){
      const d = Math.sqrt(d2) || 0.001;
      const nx = dx/d, nz = dz/d;
      const overlap = minD - d;
      player.pos.x += nx * overlap * 0.5;
      player.pos.z += nz * overlap * 0.5;
      t.pos.x -= nx * overlap * 0.5;
      t.pos.z -= nz * overlap * 0.5;

      const rvx = player.vel.x - t.vel.x;
      const rvz = player.vel.z - t.vel.z;
      const vn = rvx*nx + rvz*nz;
      if(vn < 0){
        const impactSpeed = -vn;
        if(impactSpeed > 2.5){
          const dmg = (impactSpeed - 2.5) * 1.2;
          damagePlayer(dmg, (player.pos.x+t.pos.x)/2, 0.7, (player.pos.z+t.pos.z)/2);
          bumpWanted(0.15);
        }
        const imp = impactSpeed * 0.5;
        player.vel.x += nx * imp;
        player.vel.z += nz * imp;
        t.vel.x -= nx * imp;
        t.vel.z -= nz * imp;
      }
    }
  }
}

function playerVsPedestrians(){
  for(const p of pedestrians){
    if(!p.alive) continue;
    const dx = player.pos.x - p.pos.x;
    const dz = player.pos.z - p.pos.z;
    const d2 = dx*dx + dz*dz;
    if(d2 < 1.4*1.4){
      damagePlayer(22, p.pos.x, 1.0, p.pos.z);
      bumpWanted(1.0);
      p.alive = false;
      p.deadT = 0;
      p.deathVel = new THREE.Vector3(
        (Math.random()-0.5)*8,
        6 + Math.random()*4,
        (Math.random()-0.5)*8
      );
      // gore sparks
      for(let i=0;i<10;i++){
        emitParticle(p.pos.x, 1.0, p.pos.z,
          (Math.random()-0.5)*8, 2+Math.random()*4, (Math.random()-0.5)*8,
          0.6, 0.8, 0.05, 0.05);
      }
    }
  }
}

