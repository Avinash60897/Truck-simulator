  bx(0.20,0.14,0.50, trimMat, 0.92,1.05,1.10);
  bx(0.20,0.14,0.50, trimMat, -0.92,1.05,1.10);

  const headMat = new THREE.MeshStandardMaterial({ color:0xfff8e0, emissive:0xffe8b0, emissiveIntensity:1.2 });
  bx(0.40,0.14,0.08, headMat, 0.64,0.92,2.28);
  bx(0.40,0.14,0.08, headMat, -0.64,0.92,2.28);

  const tailMat = new THREE.MeshStandardMaterial({ color:0x5a0d0d, emissive:0xff1a1a, emissiveIntensity:0.5 });
  g.userData.tailMat = tailMat;
  bx(0.36,0.12,0.08, tailMat, 0.64,0.98,-2.28);
  bx(0.36,0.12,0.08, tailMat, -0.64,0.98,-2.28);

  if(opts.police){
    const whiteMat = new THREE.MeshStandardMaterial({ color:0xf0ece0, metalness:0.4, roughness:0.5 });
    bx(0.06, 0.42, 2.2, whiteMat, 1.0, 0.62, 0);
    bx(0.06, 0.42, 2.2, whiteMat, -1.0, 0.62, 0);
    const lbGroup = new THREE.Group();
    const lbBase = new THREE.Mesh(new THREE.BoxGeometry(1.2, 0.10, 0.35), trimMat);
    lbGroup.add(lbBase);
    const redMat = new THREE.MeshStandardMaterial({ color:0xff2020, emissive:0xff0000, emissiveIntensity:1.8 });
    const blueMat = new THREE.MeshStandardMaterial({ color:0x2040ff, emissive:0x0030ff, emissiveIntensity:1.8 });
    const redL = new THREE.Mesh(new THREE.BoxGeometry(0.50, 0.16, 0.28), redMat);
    redL.position.set(-0.30, 0.13, 0);
    const blueL = new THREE.Mesh(new THREE.BoxGeometry(0.50, 0.16, 0.28), blueMat);
    blueL.position.set(0.30, 0.13, 0);
