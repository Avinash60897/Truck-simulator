function buildCarBody(paintColor, trimColor, opts = {}){
  const g = new THREE.Group();
  const bodyMat = new THREE.MeshStandardMaterial({ color:paintColor, metalness:0.55, roughness:0.4 });
  const trimMat = new THREE.MeshStandardMaterial({ color:trimColor, metalness:0.4, roughness:0.75 });
  const glassMat = new THREE.MeshStandardMaterial({ color:0x1a2a2a, metalness:0.9, roughness:0.1, transparent:true, opacity:0.85 });

  function bx(w,h,d,mat,x,y,z){
    const m = new THREE.Mesh(new THREE.BoxGeometry(w,h,d), mat);
    m.position.set(x,y,z);
    m.castShadow=true; m.receiveShadow=true;
    g.add(m); return m;
  }

  bx(1.95,0.48,4.60, bodyMat, 0,0.60,0);
  bx(1.80,0.36,3.80, bodyMat, 0,1.00,-0.10);
  bx(1.58,0.48,1.80, glassMat, 0,1.36,-0.40);
  bx(1.54,0.08,1.70, bodyMat, 0,1.60,-0.40);
  bx(1.98,0.14,0.30, trimMat, 0,0.42,2.25);
