  const legL = new THREE.Mesh(new THREE.CylinderGeometry(0.10, 0.10, 0.65, 5), legMat);
  legL.position.set(-0.12, 0.32, 0); g.add(legL);
  const legR = new THREE.Mesh(new THREE.CylinderGeometry(0.10, 0.10, 0.65, 5), legMat);
  legR.position.set(0.12, 0.32, 0); g.add(legR);

  scene.add(g);
  ped.mesh = g;
  pedestrians.push(ped);
  return ped;
}

