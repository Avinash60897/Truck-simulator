function updatePlayerPhysics(dt){
  const inp = readPlayerInput();
  player.throttleIn = inp.throttle;
  player.brakeIn = inp.brake;
  player.handbrakeIn = inp.handbrake;
  stepVehicle(player, inp, P_PLAYER, dt);

  collideBuildings(player, 1.4, (speed, x, y, z) => {
    if(speed > 3){
      const dmg = (speed - 3) * 2.0;
      damagePlayer(dmg, x, y, z);
      bumpWanted(0.1);
    } else if(speed > 1.5){
      // light scrape sparks
      for(let i=0;i<3;i++){
        emitParticle(x, y + Math.random()*0.5, z,
          (Math.random()-0.5)*4, 1+Math.random()*2, (Math.random()-0.5)*4,
          0.3, 1.2, 0.8, 0.3);
      }
    }
  });

  playerVsPolice();
  playerVsTraffic();
  playerVsPedestrians();
}

/* ============================================================
   MAIN LOOP
   ============================================================ */
const FIXED = 1/120;
let accumulator = 0;
let lastTime = performance.now();

function loop(now){
  requestAnimationFrame(loop);
  let dt = (now - lastTime) / 1000;
  lastTime = now;
  if(dt > 0.1) dt = 0.1;

  if(!gameOver){
    accumulator += dt;
    let steps = 0;
    while(accumulator >= FIXED && steps < 10){
      updatePlayerPhysics(FIXED);
      updatePolice(FIXED);
      accumulator -= FIXED;
      steps++;
    }
    if(steps === 10) accumulator = 0;
    updateTraffic(dt);
    updatePedestrians(dt);

    survivalTime += dt;
    const mult = 1 + (wantedLevel - 1) * 0.25;
    score += dt * 100 * mult;
  } else {
    accumulator = 0;
  }

  updateParticles(dt);
  updateVisuals(dt);
  updateHUD(dt);
  renderer.render(scene, camera);
}

/* ============================================================
   RESIZE
   ============================================================ */
addEventListener('resize', () => {
  camera.aspect = innerWidth/innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});

/* ============================================================
   BOOT
   ============================================================ */
camera.position.set(0, 4, -9);
for(let i=0;i<4;i++) spawnPolice();
for(let i=0;i<28;i++) spawnTraffic();
for(let i=0;i<40;i++) spawnPedestrian();

requestAnimationFrame(loop);

// intro fade
setTimeout(() => {
  document.getElementById('intro').classList.add('hide');
}, 1800);
</script>
