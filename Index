function makeWheels(carGroup){
  const WHEEL_R = 0.36;
  const tireGeo = new THREE.CylinderGeometry(WHEEL_R, WHEEL_R, 0.28, 16);
  tireGeo.rotateZ(Math.PI/2);
  const rimGeo = new THREE.CylinderGeometry(0.22, 0.22, 0.29, 8);
  rimGeo.rotateZ(Math.PI/2);
  const tireMat = new THREE.MeshStandardMaterial({ color:0x111111, roughness:0.95 });
  const rimMat = new THREE.MeshStandardMaterial({ color:0xd4c89a, metalness:0.9, roughness:0.35 });
  function w(x,z){
    const pivot = new THREE.Group();
    pivot.position.set(x, WHEEL_R, z);
    const spin = new THREE.Group();
    const tire = new THREE.Mesh(tireGeo, tireMat);
    tire.castShadow = true; spin.add(tire);
    spin.add(new THREE.Mesh(rimGeo, rimMat));
    pivot.add(spin);
    carGroup.add(pivot);
    return { pivot, spin };
  }
  return {
    fl: w(-0.88, 1.45), fr: w(0.88, 1.45),
    rl: w(-0.88, -1.45), rr: w(0.88, -1.45),
    R: WHEEL_R
  };
}

