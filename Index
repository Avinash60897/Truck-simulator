};

const GEARS = [3.10,1.95,1.35,1.02,0.82,0.68];
const FINAL = 3.55;
const MAX_RPM = 6800;
const IDLE_RPM = 850;

const TORQUE_CURVE = [
  [0,70],[800,150],[1500,240],[2500,310],[3500,355],
  [4500,360],[5500,340],[6500,290],[7000,220],[7500,130]
];
function engineTorque(rpm){
  const c = TORQUE_CURVE;
  if(rpm<=c[0][0]) return c[0][1];
  for(let i=0;i<c.length-1;i++){
    if(rpm<=c[i+1][0]){
      const t = (rpm-c[i][0])/(c[i+1][0]-c[i][0]);
      return c[i][1] + t*(c[i+1][1]-c[i][1]);
    }
  }
  return c[c.length-1][1];
}

const _f = new THREE.Vector3(), _r = new THREE.Vector3();
const _fd = new THREE.Vector3(), _rd = new THREE.Vector3();
const _vF = new THREE.Vector3(), _vR = new THREE.Vector3();
const _Fw = new THREE.Vector3();
const _v1 = new THREE.Vector3(), _v2 = new THREE.Vector3(), _v3 = new THREE.Vector3();

/* ============================================================
   VEHICLE PHYSICS STEP
   ============================================================ */
function stepVehicle(v, inp, par, dt){
  const m = par.mass, g = 9.81;
  const L = par.a + par.b;

  _f.set(Math.sin(v.yaw), 0, Math.cos(v.yaw));
  _r.set(-Math.cos(v.yaw), 0, Math.sin(v.yaw));

  const vLong = v.vel.dot(_f);
  const speedAbs = Math.abs(vLong);

  const Fzf = Math.max(300, m*g*par.b/L - m*v.ax*par.h/L);
  const Fzr = Math.max(300, m*g*par.a/L + m*v.ax*par.h/L);

  const steerLimit = par.steerLimit * (1 - par.steerSpeedFactor*Math.min(1, speedAbs/40));
  const targetSteer = inp.steer * steerLimit;
  v.steer += (targetSteer - v.steer) * Math.min(1, dt*par.steerSpeed);

  let Fx = 0;

  if(v.isPlayer){
    const ratio = GEARS[v.gear-1] * FINAL;
    let rpm = speedAbs / par.wheelR * ratio * 60 / (2*Math.PI);
    rpm = Math.max(IDLE_RPM, Math.min(MAX_RPM, rpm));

    if(inp.brake > 0.3 && inp.throttle < 0.1 && vLong < 0.7 && !v.reversing) v.reversing = true;
    if(inp.throttle > 0.1 && vLong > -0.7) v.reversing = false;

    v.shiftT = Math.max(0, v.shiftT - dt);
    if(!v.reversing && v.shiftT <= 0){
      if(rpm > 6100 && v.gear < GEARS.length && inp.throttle > 0.1){ v.gear++; v.shiftT = 0.28; }
      else if(rpm < 1850 && v.gear > 1 && speedAbs > 2){ v.gear--; v.shiftT = 0.16; }
    }
    v.rpm = v.reversing
      ? Math.max(IDLE_RPM, Math.min(3800, IDLE_RPM + speedAbs*250))
      : rpm;

    if(v.reversing){
      if(vLong > -8) Fx -= inp.brake * 4600;
    } else {
      const tq = engineTorque(rpm) * (v.shiftT>0 ? 0.12 : 1);
      let drive = inp.throttle * tq * ratio * 0.85 / par.wheelR;
      const traction = par.mu * Fzr;
      drive = Math.max(-traction, Math.min(traction, drive));
      Fx += drive;
      if(inp.throttle < 0.05 && speedAbs > 0.6) Fx -= Math.sign(vLong) * Math.min(1700, rpm*0.18);
      if(inp.brake > 0){
        const bf = inp.brake * par.maxBrake;
        const maxStop = speedAbs * m / dt;
        Fx -= Math.sign(vLong) * Math.min(bf, maxStop);
      }
    }
  } else {
    const speedFactor = Math.max(0, 1 - speedAbs/par.maxSpeed);
    let drive = inp.throttle * par.maxForce * speedFactor;
    const traction = par.mu * Fzr;
    drive = Math.max(-traction, Math.min(traction, drive));
    Fx += drive;
    if(inp.brake > 0){
      const bf = inp.brake * par.maxBrake;
      const maxStop = speedAbs * m / dt;
      Fx -= Math.sign(vLong) * Math.min(bf, maxStop);
    }
  }

  if(inp.handbrake && speedAbs > 0.1){
    Fx -= Math.sign(vLong) * Math.min(9500, speedAbs*m/dt);
  }

  Fx -= 0.5 * 1.225 * 0.34 * 2.2 * vLong * speedAbs;
  if(speedAbs > 0.12) Fx -= 0.014 * m * g * Math.sign(vLong);
  else if(Math.abs(Fx) < 400 && inp.throttle < 0.05) v.vel.set(0,0,0);

  _fd.copy(_f).applyAxisAngle(UP, v.steer);
  _rd.copy(_r).applyAxisAngle(UP, v.steer);

  _vF.copy(v.vel).addScaledVector(_r, -par.a * v.omega);
  _vR.copy(v.vel).addScaledVector(_r, par.b * v.omega);

  const vFf = _vF.dot(_fd), vFr = _vF.dot(_rd);
  const vRf = _vR.dot(_f), vRr = _vR.dot(_r);

  const alphaF = Math.atan2(vFr, Math.max(Math.abs(vFf), 1.5));
  const alphaR = Math.atan2(vRr, Math.max(Math.abs(vRf), 1.5));

  let Fyf = -par.Cf * alphaF;
  let Fyr = -par.Cr * alphaR;

  const gripF = par.mu * Fzf;
  const gripR = par.mu * Fzr * (inp.handbrake ? 0.40 : 1);
  Fyf = Math.max(-gripF, Math.min(gripF, Fyf));
  Fyr = Math.max(-gripR, Math.min(gripR, Fyr));

  _Fw.set(0,0,0);
  _Fw.addScaledVector(_rd, Fyf);
  _Fw.addScaledVector(_r, Fyr);
  _Fw.addScaledVector(_f, Fx);

  const torque = -par.a * Fyf * Math.cos(v.steer) + par.b * Fyr;

  v.ax = _Fw.dot(_f) / m;
  v.vel.addScaledVector(_Fw, dt/m);
  v.omegaDyn += torque / par.Iz * dt;

  const kv = Math.min(1, Math.max(0, (speedAbs - 0.8)/3.5));
  const omegaKin = vLong * Math.tan(v.steer) / L;
  v.omega = kv * v.omegaDyn + (1-kv) * omegaKin;
  v.omegaDyn = v.omega;

  v.yaw += v.omega * dt;
  v.pos.addScaledVector(v.vel, dt);

  const latSpeed = v.vel.dot(_r);
  if(Math.abs(latSpeed) > 0.05){
    const damp = Math.min(1, dt*(1.8 + Math.abs(latSpeed)*0.5));
    v.vel.addScaledVector(_r, -latSpeed*damp);
  }

  v.wheelSpin += vLong / par.wheelR * dt;
}

function collideBuildings(v, radius, damageCb){
  for(const c of colliders){
    const cx = Math.max(c.minX, Math.min(v.pos.x, c.maxX));
    const cz = Math.max(c.minZ, Math.min(v.pos.z, c.maxZ));
    const dx = v.pos.x - cx;
    const dz = v.pos.z - cz;
    const d2 = dx*dx + dz*dz;
    if(d2 < radius*radius){
      let nx, nz, pen;
      if(d2 < 1e-6){
        const dl = v.pos.x - c.minX, dr = c.maxX - v.pos.x;
        const db = v.pos.z - c.minZ, df = c.maxZ - v.pos.z;
        const mn = Math.min(dl, dr, db, df);
        if(mn===dl){nx=-1;nz=0;}
        else if(mn===dr){nx=1;nz=0;}
        else if(mn===db){nx=0;nz=-1;}
        else{nx=0;nz=1;}
        pen = mn + radius;
      } else {
        const d = Math.sqrt(d2);
        nx = dx/d; nz = dz/d; pen = radius - d;
      }
      v.pos.x += nx*pen;
      v.pos.z += nz*pen;
      const vn = v.vel.x*nx + v.vel.z*nz;
      if(vn < 0){
        if(damageCb) damageCb(-vn, v.pos.x, 0.9, v.pos.z);
        v.vel.x -= vn*nx*1.3;
        v.vel.z -= vn*nz*1.3;
      }
      v.vel.multiplyScalar(0.85);
      v.omega *= 0.55;
    }
  }
  const B = 344;
  if(v.pos.x >  B){ v.pos.x =  B; if(v.vel.x > 2) damageCb && damageCb(v.vel.x, B, 0.9, v.pos.z); v.vel.x *= -0.3; }
  if(v.pos.x < -B){ v.pos.x = -B; if(v.vel.x < -2) damageCb && damageCb(-v.vel.x, -B, 0.9, v.pos.z); v.vel.x *= -0.3; }
  if(v.pos.z >  B){ v.pos.z =  B; if(v.vel.z > 2) damageCb && damageCb(v.vel.z, v.pos.x, 0.9, B); v.vel.z *= -0.3; }
  if(v.pos.z < -B){ v.pos.z = -B; if(v.vel.z < -2) damageCb && damageCb(-v.vel.z, v.pos.x, 0.9, -B); v.vel.z *= -0.3; }
}

