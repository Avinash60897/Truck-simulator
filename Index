<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Driver — Police Chase</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{width:100%;height:100%;overflow:hidden;background:#0a0a0f;
    font-family:-apple-system,BlinkMacSystemFont,'Inter','Segoe UI',system-ui,sans-serif;
    user-select:none;-webkit-font-smoothing:antialiased}
  canvas{display:block}

  #hud{position:fixed;inset:0;pointer-events:none;z-index:10}

  /* ---- vignette overlay for premium feel ---- */
  #vignette{position:absolute;inset:0;pointer-events:none;
    background:radial-gradient(ellipse at center,transparent 40%,rgba(0,0,0,0.55) 100%)}
  #damageVignette{position:absolute;inset:0;pointer-events:none;
    background:radial-gradient(ellipse at center,transparent 35%,rgba(180,10,10,0) 100%);
    transition:opacity .3s}
  #damageFlash{position:absolute;inset:0;background:rgba(220,40,30,0);
    pointer-events:none;transition:background .08s linear}

  /* ---- glass panel base ---- */
  .panel{
    background:linear-gradient(160deg,rgba(20,18,26,0.82),rgba(10,9,14,0.92));
    border:1px solid rgba(255,190,90,0.14);
    border-radius:14px;
    backdrop-filter:blur(14px) saturate(140%);
    -webkit-backdrop-filter:blur(14px) saturate(140%);
    box-shadow:0 12px 44px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.06);
  }

  /* ---- title ---- */
  #title{
    position:absolute;left:26px;top:24px;
    font-size:11px;letter-spacing:6px;font-weight:600;
    color:rgba(255,220,150,.55);text-transform:uppercase;
  }
  #title .accent{color:#ffb850}

  /* ---- best score (top right) ---- */
  #bestPanel{
    position:absolute;right:26px;top:24px;padding:10px 18px;
    text-align:right;min-width:150px;
  }
  #bestPanel .lbl{
    font-size:9px;letter-spacing:4px;font-weight:600;
    color:rgba(255,220,150,.4);text-transform:uppercase;display:block;margin-bottom:3px;
  }
  #bestPanel .val{
    font-size:22px;font-weight:700;color:#ffc766;
    text-shadow:0 0 20px rgba(255,180,70,.5);
    font-variant-numeric:tabular-nums;line-height:1;
  }
  #bestPanel .sub{
    font-size:10px;color:rgba(255,220,150,.4);letter-spacing:1px;margin-top:3px;
  }

  /* ---- wanted stars (top center) ---- */
  #wanted{
    position:absolute;left:50%;top:22px;transform:translateX(-50%);
    text-align:center;
  }
  #wanted .lbl{
    font-size:9px;letter-spacing:5px;font-weight:600;
    color:rgba(255,220,150,.45);text-transform:uppercase;display:block;margin-bottom:6px;
  }
  #stars{font-size:26px;letter-spacing:6px;line-height:1;
    transition:filter .3s}
  #stars .on{color:#ffb348;text-shadow:0 0 18px rgba(255,150,50,.9),
    0 0 36px rgba(255,120,30,.4)}
  #stars .off{color:rgba(120,90,50,.22);text-shadow:none}

  /* ---- main score display ---- */
  #scoreCenter{
    position:absolute;left:50%;top:96px;transform:translateX(-50%);
    text-align:center;padding:16px 40px 14px;min-width:340px;
  }
  #scoreCenter .timeLbl{
    font-size:9px;letter-spacing:5px;font-weight:600;
    color:rgba(255,220,150,.4);text-transform:uppercase;
  }
  #scoreCenter .timeVal{
    font-size:52px;font-weight:800;color:#fff2d8;line-height:1;
    margin-top:4px;font-variant-numeric:tabular-nums;
    text-shadow:0 0 30px rgba(255,200,120,.35),0 0 60px rgba(255,150,60,.15);
    letter-spacing:-1px;
  }
  #scoreCenter .scoreVal{
    font-size:13px;letter-spacing:3px;font-weight:600;
    color:#ffb850;margin-top:6px;font-variant-numeric:tabular-nums;
    text-shadow:0 0 14px rgba(255,160,60,.5);
  }
  #scoreCenter .mult{
    display:inline-block;font-size:10px;letter-spacing:2px;
    color:rgba(255,220,150,.55);margin-left:8px;
  }

  /* ---- dashboard ---- */
  #dash{
    position:absolute;right:26px;bottom:26px;
    width:260px;padding:16px 20px 16px;
  }
  #dash .row1{display:flex;align-items:flex-end;justify-content:space-between}
  #gear{
    font-size:44px;font-weight:800;line-height:.9;color:#ffe4a8;
    text-shadow:0 0 22px rgba(255,190,90,.55);min-width:52px;
    font-variant-numeric:tabular-nums;
  }
  #gear.rev{color:#ff9143;text-shadow:0 0 22px rgba(255,120,50,.65)}
  #speedWrap{text-align:right}
  #speed{font-size:44px;font-weight:800;color:#fff5e0;line-height:.9;
    text-shadow:0 0 22px rgba(255,220,160,.35);font-variant-numeric:tabular-nums;
    letter-spacing:-1px}
  #unit{display:block;font-size:9px;letter-spacing:4px;font-weight:600;
    color:rgba(255,220,150,.42);margin-top:3px;text-align:right}

  #rpmBar{margin-top:14px;height:6px;border-radius:3px;overflow:hidden;
    background:rgba(255,220,150,.07);position:relative}
  #rpmFill{height:100%;width:0%;border-radius:3px;
    background:linear-gradient(90deg,#3ac46a,#e8c43a 62%,#ff3a3a 92%);
    box-shadow:0 0 12px rgba(255,120,60,.35);
    transition:width .05s linear}

  #healthSection{margin-top:12px}
  #healthLbl{font-size:9px;letter-spacing:4px;font-weight:600;
    color:rgba(255,220,150,.42);margin-bottom:4px;
    display:flex;justify-content:space-between}
  #healthLbl .num{color:#ffe4a8;font-weight:700}
  #healthBar{height:10px;border-radius:5px;overflow:hidden;
    background:rgba(255,220,150,.07);position:relative}
  #healthFill{height:100%;width:100%;border-radius:5px;
    background:linear-gradient(90deg,#3ac46a,#5ae08a);
    transition:width .2s ease,background .4s ease,box-shadow .3s;
    box-shadow:0 0 14px rgba(90,224,140,.35)}

  /* ---- controls ---- */
  #help{
    position:absolute;left:26px;bottom:26px;
    font-size:11px;line-height:2;color:rgba(255,220,150,.55);
    padding:14px 20px;
  }
  #help .key{
    display:inline-block;min-width:22px;padding:1px 6px;margin:0 2px;
    background:rgba(255,190,90,.1);border:1px solid rgba(255,190,90,.2);
    border-radius:5px;color:#ffd88a;font-weight:600;font-size:10px;
    text-align:center;
  }

  /* ---- game over ---- */
  #gameOver{
    position:absolute;inset:0;display:none;align-items:center;justify-content:center;
    flex-direction:column;background:radial-gradient(ellipse at center,rgba(30,8,8,.7),rgba(5,3,3,.94));
    pointer-events:none;
  }
  #gameOver.show{display:flex;animation:fadeIn .6s ease}
  @keyframes fadeIn{from{opacity:0}to{opacity:1}}
  #gameOver h1{
    font-size:82px;letter-spacing:18px;font-weight:800;
    color:#ff4a4a;margin-bottom:6px;
    text-shadow:0 0 40px rgba(255,60,60,.65),0 0 80px rgba(255,40,40,.35);
    animation:pulse 2s ease-in-out infinite;
  }
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.85}}
  #gameOver .tagline{
    font-size:11px;letter-spacing:8px;font-weight:600;
    color:rgba(255,200,140,.5);text-transform:uppercase;margin-bottom:36px;
  }
  #gameOver .statsPanel{
    padding:26px 54px;min-width:420px;text-align:center;
  }
  #gameOver .statRow{
    display:flex;justify-content:space-between;align-items:center;
    padding:10px 0;font-size:13px;
    border-bottom:1px solid rgba(255,190,90,.08);
  }
  #gameOver .statRow:last-child{border-bottom:none}
  #gameOver .statRow .k{
    letter-spacing:4px;font-weight:600;
    color:rgba(255,220,150,.45);text-transform:uppercase;font-size:10px;
  }
  #gameOver .statRow .v{
    font-size:22px;font-weight:700;color:#ffe4a8;
    font-variant-numeric:tabular-nums;
    text-shadow:0 0 16px rgba(255,180,80,.4)
  }
  #gameOver .statRow .v.big{
    font-size:30px;color:#ffc766;
    text-shadow:0 0 24px rgba(255,160,60,.6)
  }
  #gameOver .statRow .v.record{
    color:#5ae08a;text-shadow:0 0 24px rgba(90,224,138,.7)
  }
  #gameOver .newRecord{
    margin-top:14px;font-size:12px;letter-spacing:6px;font-weight:700;
    color:#5ae08a;text-shadow:0 0 20px rgba(90,224,138,.7);
    animation:glow 1.6s ease-in-out infinite;
  }
  @keyframes glow{0%,100%{opacity:.7}50%{opacity:1}}
  #gameOver .restart{
    margin-top:34px;font-size:12px;letter-spacing:6px;font-weight:600;
    color:rgba(255,220,150,.65);
  }
  #gameOver .restart b{color:#ffc766;font-weight:700}

  /* intro fade */
  #intro{
    position:absolute;inset:0;background:#0a0a0f;
    display:flex;align-items:center;justify-content:center;flex-direction:column;
    z-index:100;transition:opacity 1s ease;
  }
  #intro.hide{opacity:0;pointer-events:none}
  #intro .brand{
    font-size:13px;letter-spacing:16px;font-weight:600;
    color:rgba(255,190,90,.6);text-transform:uppercase;
  }
  #intro .line{
    width:60px;height:1px;background:rgba(255,190,90,.4);margin:20px 0;
  }
  #intro .sub{
    font-size:11px;letter-spacing:8px;
    color:rgba(255,220,150,.35);text-transform:uppercase;
  }
</style>
</head>
<body>

<div id="hud">
  <div id="title">DRIVER · <span class="accent">POLICE CHASE</span></div>

  <div id="wanted" class="panel">
    <span class="lbl">WANTED LEVEL</span>
    <span id="stars"></span>
  </div>

  <div id="scoreCenter" class="panel">
    <div class="timeLbl">SURVIVAL TIME</div>
    <div class="timeVal" id="timeVal">00.0</div>
    <div><span class="scoreVal" id="scoreVal">SCORE 0</span><span class="mult" id="multVal">×1.0</span></div>
  </div>

  <div id="bestPanel" class="panel">
    <span class="lbl">Best Run</span>
    <span class="val" id="bestVal">0.0s</span>
    <div class="sub" id="bestScoreVal">SCORE 0</div>
  </div>

  <div id="dash" class="panel">
    <div class="row1">
      <div id="gear">1</div>
      <div id="speedWrap"><span id="speed">0</span><span id="unit">MPH</span></div>
    </div>
    <div id="rpmBar"><div id="rpmFill"></div></div>
    <div id="healthSection">
      <div id="healthLbl"><span>DAMAGE</span><span class="num" id="healthNum">100</span></div>
      <div id="healthBar"><div id="healthFill"></div></div>
    </div>
  </div>

  <div id="help" class="panel">
    <span class="key">W</span> throttle &nbsp;·&nbsp; <span class="key">S</span> brake / reverse<br>
    <span class="key">A</span><span class="key">D</span> steer &nbsp;·&nbsp;
    <span class="key">SPC</span> handbrake<br>
    <span class="key">C</span> camera &nbsp;·&nbsp; <span class="key">R</span> restart
  </div>

  <div id="vignette"></div>
  <div id="damageVignette"></div>
  <div id="damageFlash"></div>

  <div id="gameOver">
    <h1>WRECKED</h1>
    <div class="tagline">Your car is totaled</div>
    <div class="statsPanel panel">
      <div class="statRow">
        <span class="k">Time Survived</span>
        <span class="v big" id="goTime">0.0s</span>
      </div>
      <div class="statRow">
        <span class="k">Final Score</span>
        <span class="v" id="goScore">0</span>
      </div>
      <div class="statRow">
        <span class="k">Best Time</span>
        <span class="v" id="goBest">0.0s</span>
      </div>
    </div>
    <div class="newRecord" id="newRecord" style="display:none">NEW RECORD</div>
    <div class="restart">PRESS <b>R</b> TO RESTART</div>
  </div>
</div>

<div id="intro">
  <div class="brand">Driver</div>
  <div class="line"></div>
  <div class="sub">You Are The Wheelman</div>
</div>

<script type="importmap">
{ "imports": { "three": "https://unpkg.com/three@0.160.0/build/three.module.js" } }
</script>

<script type="module">
import * as THREE from 'three';

/* ============================================================
   RENDERER / SCENE
   ============================================================ */
const renderer = new THREE.WebGLRenderer({ antialias:true, powerPreference:'high-performance' });
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.setSize(innerWidth, innerHeight);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 0.95;
document.body.appendChild(renderer.domElement);

const scene = new THREE.Scene();
const SKY = 0xc4a86a;
scene.background = new THREE.Color(SKY);
scene.fog = new THREE.Fog(SKY, 130, 500);

const camera = new THREE.PerspectiveCamera(62, innerWidth/innerHeight, 0.2, 3000);
const UP = new THREE.Vector3(0,1,0);

/* ============================================================
   LIGHTS
   ============================================================ */
scene.add(new THREE.HemisphereLight(0xd4b87a, 0x4a3a2a, 0.75));
const sun = new THREE.DirectionalLight(0xffe8b0, 1.9);
sun.position.set(140,190,90);
sun.castShadow = true;
sun.shadow.mapSize.set(2048,2048);
const SD = 100;
sun.shadow.camera.left=-SD; sun.shadow.camera.right=SD;
sun.shadow.camera.top=SD; sun.shadow.camera.bottom=-SD;
sun.shadow.camera.near=1; sun.shadow.camera.far=650;
sun.shadow.bias=-0.0006; sun.shadow.normalBias=0.02;
scene.add(sun); scene.add(sun.target);

/* ============================================================
   GROUND
   ============================================================ */
const ground = new THREE.Mesh(
  new THREE.PlaneGeometry(3000,3000),
  new THREE.MeshStandardMaterial({ color:0x6b7a4a, roughness:1 })
);
ground.rotation.x = -Math.PI/2;
ground.receiveShadow = true;
scene.add(ground);

/* ============================================================
   CITY
   ============================================================ */
const ROADS = [-240,-160,-80,0,80,160,240];
const ROAD_W = 14;
const ROAD_LEN = 620;
const colliders = [];

function makeRoadTexture(){
  const c = document.createElement('canvas');
  c.width=256; c.height=128;
  const g = c.getContext('2d');
  g.fillStyle='#4a4a4a'; g.fillRect(0,0,256,128);
  for(let i=0;i<2600;i++){
    const v = 55 + Math.random()*40;
    g.fillStyle = `rgba(${v},${v},${v+4},0.5)`;
    g.fillRect(Math.random()*256, Math.random()*128, 1.6, 1.6);
  }
  g.fillStyle='#d4c89a'; g.fillRect(0,6,256,3); g.fillRect(0,119,256,3);
  g.fillStyle='#e8dca8'; g.fillRect(0,61,130,4);
  const t = new THREE.CanvasTexture(c);
  t.wrapS=t.wrapT=THREE.RepeatWrapping;
  t.repeat.set(ROAD_LEN/12,1);
  t.anisotropy = renderer.capabilities.getMaxAnisotropy();
  return t;
}
const roadMat = new THREE.MeshStandardMaterial({ map:makeRoadTexture(), roughness:0.96, metalness:0.02 });
const roadGeoBase = new THREE.PlaneGeometry(ROAD_LEN, ROAD_W);
roadGeoBase.rotateX(-Math.PI/2);
const roadGeoX = roadGeoBase;
const roadGeoZ = roadGeoBase.clone().rotateY(Math.PI/2);
for(const x of ROADS){
  const m = new THREE.Mesh(roadGeoZ, roadMat);
  m.position.set(x, 0.021, 0); m.receiveShadow=true; scene.add(m);
}
for(const z of ROADS){
  const m = new THREE.Mesh(roadGeoX, roadMat);
  m.position.set(0, 0.020, z); m.receiveShadow=true; scene.add(m);
}

const sidewalkMat = new THREE.MeshStandardMaterial({ color:0x9a8a7a, roughness:1 });
for(const x of ROADS){
  for(const s of [-1,1]){
    const sw = new THREE.Mesh(new THREE.BoxGeometry(2.5,0.14,ROAD_LEN), sidewalkMat);
    sw.position.set(x + s*(ROAD_W/2+1.25), 0.07, 0);
    sw.receiveShadow=true; scene.add(sw);
  }
}
for(const z of ROADS){
  for(const s of [-1,1]){
    const sw = new THREE.Mesh(new THREE.BoxGeometry(ROAD_LEN,0.14,2.5), sidewalkMat);
    sw.position.set(0, 0.07, z + s*(ROAD_W/2+1.25));
    sw.receiveShadow=true; scene.add(sw);
  }
}

const bColors = [0x8a7a6a,0x9a8a7a,0x7a6a5a,0x6a5a4a,0xa89888,0x8a7a5a,0x7a6a4a,0x9a8a8a];
const bMats = bColors.map(c => new THREE.MeshStandardMaterial({ color:c, roughness:0.9, metalness:0.02 }));

function addBuilding(cx,cz,w,d,h){
  const mesh = new THREE.Mesh(new THREE.BoxGeometry(w,h,d), bMats[(Math.random()*bMats.length)|0]);
  mesh.position.set(cx,h/2,cz);
  mesh.castShadow=true; mesh.receiveShadow=true;
  scene.add(mesh);
  const cap = new THREE.Mesh(
    new THREE.BoxGeometry(w*1.04,0.5,d*1.04),
    new THREE.MeshStandardMaterial({ color:0x5a4a3a, roughness:0.9 })
  );
  cap.position.set(cx,h+0.25,cz); cap.castShadow=true; scene.add(cap);
  colliders.push({ minX:cx-w/2, maxX:cx+w/2, minZ:cz-d/2, maxZ:cz+d/2 });
}

for(let i=0;i<ROADS.length-1;i++){
  for(let j=0;j<ROADS.length-1;j++){
    const x0 = ROADS[i]+ROAD_W/2+5;
    const x1 = ROADS[i+1]-ROAD_W/2-5;
    const z0 = ROADS[j]+ROAD_W/2+5;
    const z1 = ROADS[j+1]-ROAD_W/2-5;
    const N = 2;
    for(let a=0;a<N;a++) for(let b=0;b<N;b++){
      if(Math.random()<0.12) continue;
      const cellW = (x1-x0)/N, cellD = (z1-z0)/N;
      const cx = x0+cellW*(a+0.5)+(Math.random()-0.5)*3;
      const cz = z0+cellD*(b+0.5)+(Math.random()-0.5)*3;
      const w = cellW*(0.55+Math.random()*0.35);
      const d = cellD*(0.55+Math.random()*0.35);
      const h = 8+Math.random()*30;
      addBuilding(cx,cz,w,d,h);
    }
  }
}

const trunkGeo = new THREE.CylinderGeometry(0.22,0.32,2.6,7);
const trunkMat = new THREE.MeshStandardMaterial({ color:0x5a4433, roughness:1 });
const leafGeo = new THREE.ConeGeometry(2.0,5.4,8);
const leafMats = [
  new THREE.MeshStandardMaterial({ color:0x3a6b3a, roughness:1 }),
  new THREE.MeshStandardMaterial({ color:0x4a7a4a, roughness:1 }),
  new THREE.MeshStandardMaterial({ color:0x2a5a2a, roughness:1 })
];
function onRoad(x,z){
  for(const r of ROADS){
    if(Math.abs(x-r)<ROAD_W/2+2.5) return true;
    if(Math.abs(z-r)<ROAD_W/2+2.5) return true;
  }
  return false;
}
function inBuilding(x,z,m=2){
  for(const c of colliders){
    if(x>c.minX-m && x<c.maxX+m && z>c.minZ-m && z<c.maxZ+m) return true;
  }
  return false;
}
for(let i=0;i<260;i++){
  const x = (Math.random()-0.5)*660;
  const z = (Math.random()-0.5)*660;
  if(onRoad(x,z) || inBuilding(x,z,3)) continue;
  const g = new THREE.Group();
  const trunk = new THREE.Mesh(trunkGeo, trunkMat);
  trunk.position.y = 1.3; trunk.castShadow=true; g.add(trunk);
  const leaf = new THREE.Mesh(leafGeo, leafMats[(Math.random()*3)|0]);
  leaf.position.y = 4.4; leaf.castShadow=true; g.add(leaf);
  g.position.set(x,0,z);
  g.rotation.y = Math.random()*Math.PI;
  const s = 0.75+Math.random()*0.7;
  g.scale.setScalar(s);
  scene.add(g);
}

const fenceMat = new THREE.MeshStandardMaterial({ color:0x7a6a4a, roughness:0.8, metalness:0.2 });
for(let s=0;s<4;s++){
  const f = new THREE.Mesh(new THREE.BoxGeometry(700,2.4,0.5), fenceMat);
  const ang = s*Math.PI/2;
  f.position.set(Math.sin(ang)*350, 1.2, Math.cos(ang)*350);
  f.rotation.y = ang; f.castShadow=true; scene.add(f);
}

/* ============================================================
   PARTICLE SYSTEM (sparks, debris, smoke)
   ============================================================ */
const MAX_PARTICLES = 700;
const pPositions = new Float32Array(MAX_PARTICLES*3);
const pVelocities = new Float32Array(MAX_PARTICLES*3);
const pColors = new Float32Array(MAX_PARTICLES*3);
const pBaseColors = new Float32Array(MAX_PARTICLES*3);
const pLife = new Float32Array(MAX_PARTICLES);
const pMaxLife = new Float32Array(MAX_PARTICLES);
let pIdx = 0;

for(let i=0;i<MAX_PARTICLES;i++){ pPositions[i*3+1] = -1000; }

const pGeo = new THREE.BufferGeometry();
pGeo.setAttribute('position', new THREE.BufferAttribute(pPositions, 3));
pGeo.setAttribute('color', new THREE.BufferAttribute(pColors, 3));

const pMat = new THREE.PointsMaterial({
  size:0.36, vertexColors:true, transparent:true,
  blending:THREE.AdditiveBlending, depthWrite:false, sizeAttenuation:true
});
const particles = new THREE.Points(pGeo, pMat);
particles.frustumCulled = false;
scene.add(particles);

function emitParticle(x,y,z,vx,vy,vz,life,r,g,b){
  const i = pIdx;
  pIdx = (pIdx+1) % MAX_PARTICLES;
  pPositions[i*3]   = x; pPositions[i*3+1] = y; pPositions[i*3+2] = z;
  pVelocities[i*3]  = vx; pVelocities[i*3+1] = vy; pVelocities[i*3+2] = vz;
  pBaseColors[i*3]  = r; pBaseColors[i*3+1] = g; pBaseColors[i*3+2] = b;
  pColors[i*3] = r; pColors[i*3+1] = g; pColors[i*3+2] = b;
  pLife[i] = life; pMaxLife[i] = life;
}

function updateParticles(dt){
  for(let i=0;i<MAX_PARTICLES;i++){
    if(pLife[i] <= 0) continue;
    pLife[i] -= dt;
    if(pLife[i] <= 0){ pPositions[i*3+1] = -1000; continue; }
    pVelocities[i*3+1] -= 14 * dt;
    pVelocities[i*3]   *= (1 - dt*1.2);
    pVelocities[i*3+2] *= (1 - dt*1.2);
    pPositions[i*3]   += pVelocities[i*3]   * dt;
    pPositions[i*3+1] += pVelocities[i*3+1] * dt;
    pPositions[i*3+2] += pVelocities[i*3+2] * dt;
    if(pPositions[i*3+1] < 0.04){
      pPositions[i*3+1] = 0.04;
      pVelocities[i*3+1] *= -0.35;
      pVelocities[i*3]   *= 0.6;
      pVelocities[i*3+2] *= 0.6;
    }
    const t = Math.max(0, pLife[i] / pMaxLife[i]);
    const t2 = t*t;
    pColors[i*3]   = pBaseColors[i*3]   * t2;
    pColors[i*3+1] = pBaseColors[i*3+1] * t2;
    pColors[i*3+2] = pBaseColors[i*3+2] * t2;
  }
  pGeo.attributes.position.needsUpdate = true;
  pGeo.attributes.color.needsUpdate = true;
}

/* ---- crash effect ---- */
function crashEffect(x,y,z,intensity){
  const n = Math.floor(12 + intensity * 38);
  // Orange/yellow sparks
  for(let i=0;i<n;i++){
    const ang = Math.random() * Math.PI * 2;
    const sp = 3 + Math.random() * 10 * (0.5 + intensity * 0.6);
    const vy = 2 + Math.random() * 8;
    const white = Math.random() < 0.35;
    emitParticle(
      x + (Math.random()-0.5)*0.6,
      y + Math.random()*0.7,
      z + (Math.random()-0.5)*0.6,
      Math.cos(ang)*sp, vy, Math.sin(ang)*sp,
      0.45 + Math.random()*0.85,
      white ? 1.6 : 1.4,
      white ? 1.3 : 0.75,
      white ? 0.7 : 0.18
    );
  }
  // Fast metal sparks
  const ns = Math.floor(6 + intensity * 16);
  for(let i=0;i<ns;i++){
    emitParticle(x, y, z,
      (Math.random()-0.5)*22, 4+Math.random()*7, (Math.random()-0.5)*22,
      0.35, 1.6, 1.1, 0.35);
  }
  // Dark debris chunks
  const nd = Math.floor(4 + intensity * 10);
  for(let i=0;i<nd;i++){
    const ang = Math.random() * Math.PI * 2;
    const sp = 2 + Math.random() * 7;
    emitParticle(x, y+0.2, z,
      Math.cos(ang)*sp, 3+Math.random()*5, Math.sin(ang)*sp,
      1.0 + Math.random()*0.8,
      0.22, 0.18, 0.15);
  }
  addShake(intensity * 1.3);
}

